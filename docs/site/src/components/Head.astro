---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>

{/*
	Horizon's semantic tokens are scoped to :root[data-mode="Light"|"Dark"], while
	Starlight tracks the color scheme in data-theme. Mirror one onto the other so
	the theme toggle drives both. Inline and unbundled so it runs before first paint.
*/}
<script is:inline>
	(() => {
		const root = document.documentElement;
		const sync = () => {
			root.dataset.mode = root.dataset.theme === 'light' ? 'Light' : 'Dark';
		};
		sync();
		new MutationObserver(sync).observe(root, {
			attributeFilter: ['data-theme'],
		});
	})();
</script>

<script>
	// Register the Horizon web components used on this site. Imported explicitly
	// rather than through the Terra autoloader so Vite can bundle them statically.
	import '@nasa-terra/components/dist/components/alert/alert.js';
	import '@nasa-terra/components/dist/components/button/button.js';
	import '@nasa-terra/components/dist/components/card/card.js';
	import '@nasa-terra/components/dist/components/icon/icon.js';
	import '@nasa-terra/components/dist/components/site-header/site-header.js';
	import '@nasa-terra/components/dist/components/status-indicator/status-indicator.js';

	// Terra's heroicons resolver builds a URL relative to the autoloader script,
	// which only exists in the CDN build. We bundle instead, so it resolves against
	// the current page and 404s. Re-point it at the assets Vite emits, naming each
	// icon we use so nothing is pulled in that we do not render. An unmapped name
	// resolves to nothing and terra-icon renders empty.
	import { registerIconLibrary } from '@nasa-terra/components/dist/components/icon/library.js';
	// Copied from @nasa-terra/components/dist/assets/icons, which the package does
	// not export, so it cannot be imported by specifier. Upstream is heroicons.
	import informationCircle from '../assets/solid-information-circle.svg?url';

	const icons: Record<string, string> = {
		'solid-information-circle': informationCircle,
	};

	registerIconLibrary('heroicons', { resolver: (name) => icons[name] ?? '' });
</script>
